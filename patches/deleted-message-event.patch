+// Notify while the item and its original text still exist in memory.
+void NotifyDeletedMessage(not_null<HistoryItem*> item) {
+	auto &state = Instance();
+	if (!state.started || state.eventInFlight) {
+		return;
+	}
+	const auto json = MessageToJson(item);
+	state.eventInFlight = true;
+	Call(u"event"_q, QJsonObject{
+		{ u"type"_q, u"update"_q },
+		{ u"name"_q, u"updateDeletedMessage"_q },
+		{ u"account"_q, 0 },
+		{ u"update"_q, json },
+	});
+	state.eventInFlight = false;
+}
